# ── Motorsport Analytics — Variables de Entorno ──────────────────────────────
# Copia este archivo como .env y ajusta los valores para tu entorno.

# Orígenes CORS permitidos (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Nivel de logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directorio para archivos temporales (se crea automáticamente si no existe)
# TEMP_DIR=/tmp/motorsport-analytics

# Host y puerto del servidor
API_HOST=0.0.0.0
API_PORT=8000

# Activar recarga automática (solo en desarrollo)
API_RELOAD=false

# Tamaño máximo POR ARCHIVO subido, en MB (default: 2048). Se aplica en el backend (HTTP 413)
# y nginx (contenedor/Ingress) deriva su client_max_body_size de este mismo valor.
MAX_UPLOAD_MB=2048

# URL de la API para el frontend (usada por Vite)
VITE_API_URL=http://localhost:8000/api

# URL de la base de datos (biblioteca de sesiones). Por defecto SQLite local.
# En contenedores: postgresql+psycopg://user:pass@host:5432/db
# DATABASE_URL=sqlite:///data/motorsport.db

# Directorio para guardar archivos CSV originales (opcional)
# STORAGE_DIR=./data/storage

# Subir una vez (POST /api/files) + caché de sesiones analizadas (ver docs/DEPLOYMENT.md)
# UPLOAD_DIR=./tmp/uploads         # por defecto STORAGE_DIR/uploads si hay STORAGE_DIR, si no TEMP_DIR/uploads
# LAPTIME_HISTORY_DB=./data/laptime_history.db   # historial de vueltas (SQLite); por defecto STORAGE_DIR/laptime_history.db si hay STORAGE_DIR, si no ./data/
# UPLOAD_TTL_HOURS=24              # borra subidas sin uso pasado este tiempo
# SESSION_CACHE_MAX_MB=1024        # memoria máxima de la caché por proceso
# SESSION_CACHE_TTL_MIN=60         # minutos sin uso antes de sacar una sesión de la caché

# ── Contenedores (docker compose) ────────────────────────────────────────────
# !!! VALORES DE EJEMPLO SOLO PARA DESARROLLO LOCAL — NO USAR EN PRODUCCION !!!
# Cambia la contraseña antes de exponer nada fuera de tu maquina.
POSTGRES_USER=motorsport
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=motorsport

# Puerto del host donde se publica el frontend (nginx) y, con el perfil dev, el backend
FRONTEND_PORT=8080
BACKEND_DEV_PORT=8010

# Workers de uvicorn (cada worker mantiene su propia memoria; ver docs/DEPLOYMENT.md)
UVICORN_WORKERS=1

# Carpeta de setups de Assetto Corsa dentro del contenedor (ver docker-compose.override.example.yml)
# AC_SETUPS_DIR=/ac-setups

# Nota: DATABASE_URL y STORAGE_DIR (local: sqlite:///data/motorsport.db y ./data/storage)
# los fija docker-compose para los contenedores: postgresql+psycopg://...@postgres:5432/...
